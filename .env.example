# .env.example — Copy this to .env and fill in real values.
# NEVER commit .env to git. The .gitignore excludes it.

# Master secret for template encryption.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
BIOMETRIC_MASTER_SECRET=replace_with_64_hex_chars

# Admin password for the Streamlit admin panel.
BIOMETRIC_ADMIN_SECRET=replace_with_strong_password
